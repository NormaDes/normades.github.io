# ── Obligatoria para generar ejercicios con IA (Fase 1) ──
ANTHROPIC_API_KEY=

# ── Opcionales (Fase 1) ──
# Modelo de Claude (por defecto claude-opus-5-5; claude-sonnet-5-5 es más barato)
ANTHROPIC_MODEL=
# Máximo de ejercicios generados con IA por día (por defecto 15)
DAILY_GENERATION_LIMIT=15
# Si la defines, /api/generate exige este código (protege tu saldo si la app es pública)
APP_ACCESS_CODE=

# ── Fase 4 (biblioteca de artículos y Supabase) ──
GUARDIAN_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
