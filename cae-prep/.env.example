# ── Obligatoria para generar ejercicios con IA (Fase 1) ──
ANTHROPIC_API_KEY=

# ── Opcionales (Fase 1) ──
# Modelo de Claude (por defecto claude-opus-5-5; claude-sonnet-5-5 es más barato)
ANTHROPIC_MODEL=
# Máximo de ejercicios generados con IA por día (por defecto 15)
DAILY_GENERATION_LIMIT=15
# Solo sin Supabase: si la defines, las rutas de IA exigen este código
APP_ACCESS_CODE=

# ── Cuentas de usuario (si las defines, la app exige iniciar sesión) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Biblioteca de artículos reales (Fase 4b) ──
GUARDIAN_API_KEY=
